/.git
/.gitignore
/.editorconfig
/.nvmrc
/.distignore
/phpcs.xml.dist
/composer.json
/composer.lock
/package.json
/package-lock.json
/PINSPOT-PLAN.md
/PINSPOT-WORKFLOW.md

# Noise
*.log
*.zip
.DS_Store
Thumbs.db
