# Files/dirs excluded from the WP.org distribution zip
# (used by 10up/action-wordpress-plugin-deploy and wp-scripts plugin-zip)

# Ship /src (un-minified source) alongside the compiled /build so the
# plugin satisfies the WordPress.org "human-readable code" guideline
# without depending on an external repository.
/node_modules
/vendor
/.wordpress-org
/.github

# Dev config
/.git
/.gitignore
/.gitattributes
/.editorconfig
/.nvmrc
/.distignore
/phpcs.xml.dist
/composer.json
/composer.lock
/package.json
/package-lock.json
/PINSPOT-PLAN.md
/PINSPOT-WORKFLOW.md
/PINSPOT-SUITE-PLAN.md

# Noise
*.log
*.zip
.DS_Store
Thumbs.db
