<?xml version="1.0"?>
<ruleset name="Pinspot">
	<description>WordPress Coding Standards for the Pinspot plugin.</description>

	<!-- Scan the plugin, not the tooling. -->
	<file>.</file>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<!-- build/ holds compiled copies (incl. generated *.asset.php); src/render.php IS linted. -->
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>

	<!-- WordPress Coding Standards. -->
	<rule ref="WordPress">
		<!-- Filename convention conflicts with block render.php / pattern files. -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<!-- Verify everything is prefixed. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="pinspot"/>
				<element value="Pinspot"/>
				<element value="PINSPOT"/>
			</property>
		</properties>
	</rule>

	<!-- Verify the correct text domain everywhere. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="pinspot"/>
			</property>
		</properties>
	</rule>

	<!-- PHP compatibility: support PHP 7.4 through latest. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Minimum supported WordPress (Interactivity API stable). -->
	<config name="minimum_wp_version" value="6.6"/>
</ruleset>
